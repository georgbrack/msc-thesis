 IDATE2  =       20150525, ! Release end date, same as IDATE1
 ITIME2  =         000000, ! Release end time, same as ITIME1
 LON1    =         77.200, ! Left longitude of release box -180 < LON1 <180
 LON2    =         77.200, ! Right longitude of release box, same as LON1
 LAT1    =         28.600, ! Lower latitude of release box, -90 < LAT1 < 90
 LAT2    =         28.600, ! Upper latitude of release box same format as LAT1 
 Z1      =         50.000, ! Lower height of release box meters/hPa above reference level
 Z2      =         50.000, ! Upper height of release box meters/hPa above reference level
 ZKIND   =              1, ! Reference level 1=above ground, 2=above sea level, 3 for pressure in hPa
 MASS    =       1.0000E0, ! Total mass emitted, only relevant for fwd simulations
 PARTS   =         100000, ! Total number of particles to be released
 COMMENT =    "RELEASE NEW DELHI 1", ! Comment, written in the outputfile
